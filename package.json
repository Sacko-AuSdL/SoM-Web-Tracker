{
  "name": "som-web-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "Unofficial browser tracker for Secret of Mana Randomizer Open Mode, with manual tracking and local SNI autotracking.",
  "license": "MIT",
  "homepage": "https://sacko-ausdl.github.io/SoM-Web-Tracker/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sacko-AuSdL/SoM-Web-Tracker.git"
  },
  "bugs": { "url": "https://github.com/Sacko-AuSdL/SoM-Web-Tracker/issues" },
  "engines": { "node": ">=24" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:dist": "node scripts/verify-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "generate:map": "node scripts/generate-map-groups.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
